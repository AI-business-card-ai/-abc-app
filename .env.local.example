# Supabase (publishable + secret keys from Supabase Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stripe (test keys — also set in Vercel)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_xxx
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...
NEXT_PUBLIC_APP_URL=https://abccard.io

# Google OAuth (must match Supabase Auth → Google provider credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend (transactional email — also set in Vercel)
RESEND_API_KEY=re_...

# Rate limiting (server-only — also set in Vercel)
# HMAC salt for the Postgres rate-limit counters used by the public card exchange
# and the welcome email. A long random secret; there is deliberately no default.
# Unset, both refuse: the exchange answers 503 and no welcome email is sent.
EXCHANGE_RATE_LIMIT_SALT=

# Native app sign-in (server-only — set in Vercel before the native apps ship)
# Seals the short-lived state of a Google or Apple sign-in started in the iOS or
# Android app (lib/native/auth-flow.ts). At least 32 random characters; there is
# deliberately no default. Unset, sign-in from the native apps refuses to start.
# Web sign-in never reads it.
NATIVE_AUTH_SECRET=
