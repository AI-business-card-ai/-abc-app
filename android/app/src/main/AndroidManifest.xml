<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Backup is off. The WebView's cookies hold the ABC session, and Android's
      cloud backup and device-to-device transfer would otherwise copy that
      session onto another device. Everything ABC keeps lives in the account, so
      a new install loses nothing but the sign-in.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              A finished sign-in returns here: io.abccard.app://auth/callback
              (lib/native/deep-link.ts). Verified https app links are added once
              the release signing certificate exists and assetlinks.json can be
              published with its real SHA-256.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="auth" android:path="/callback" />
            </intent-filter>

            <!--
              A finished Gmail or CRM connection returns here:
              io.abccard.app://connect/callback (lib/connectors/native.ts). Its own
              filter rather than a second <data> in the one above: <data> elements in
              one filter combine, and a separate filter keeps each return exact. The
              app still trusts nothing from the link itself — lib/native/deep-link.ts
              checks its shape, and the claim needs the nonce this device kept and a
              signed-in owner.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" android:host="connect" android:path="/callback" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions: the network, and the camera for scanning cards and QR codes. Nothing else. -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Scanning needs a camera; installing ABC Card does not. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
