<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up or transferred to another device (Android 12+). The only
  local state worth having is the WebView's session cookie, and that must not
  travel. See AndroidManifest.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
